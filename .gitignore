# ==========================
# Analog IC Lab .gitignore
# ==========================

# 1. Ngspice Simulation Data (Bloat)
*.raw
*.out
*.log
*.tr

# 2. Pygmid / Python Data (Binaries & Caches)
*.mat
__pycache__/
*.pyc
.venv/
venv/

# 3. Layout Binaries (Keep .mag, ignore exported GDS)
*.gds
*.gdsii
*.cif

# 4. Plots and Images (Generated by scripts)
*.pdf
*.png
*.svg
*.jpg

# 5. OS & Editor Temp Files
*~
*.swp

# 6. Script-generated testbenches and result tables
temp_*.sp
*_out.txt
*_out.md
